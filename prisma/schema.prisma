// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects      Project[]
  sessions      Session[]
  accounts      Account[]
}

// Better Auth - Session 表
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Better Auth - Account 表 (用于 OAuth)
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  idToken           String? @db.Text
  expiresAt         DateTime?
  password          String? // 用于邮箱密码登录
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Verification 表 (用于邮箱验证)
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// 项目表
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String   // 关联用户
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  features    Feature[]

  @@index([userId])
}

// 模块表
model Module {
  id          String   @id @default(cuid())
  name        String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features    Feature[]
}

// 功能/需求表
model Feature {
  id               String        @id @default(cuid())
  name             String
  semanticInput    String        @db.Text  // 语义化需求输入
  gherkinContent   String        @db.Text  // Gherkin 内容
  status           FeatureStatus @default(IN_PROGRESS)
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  testCases        TestCase[]
}

// 需求状态枚举
enum FeatureStatus {
  IN_PROGRESS  // 进行中
  COMPLETED    // 已完成
}

// 测试用例状态枚举
enum TestCaseStatus {
  NOT_EXECUTED    // 未执行
  IN_PROGRESS     // 执行中
  PASSED          // 通过
  FAILED          // 失败
}

// 测试用例表
model TestCase {
  id               String         @id @default(cuid())
  caseId           String         @unique  // 用例ID（展示用）
  scenario         String                  // 场景
  precondition     String?        @db.Text // 前置条件
  steps            String         @db.Text // 操作步骤
  expectedResult   String         @db.Text // 期望结果
  environment      String?                 // 环境
  status           TestCaseStatus @default(NOT_EXECUTED)
  executor         String?                 // 执行人
  groupId          String?                 // 测试用例组ID（同一场景多个期望时使用）
  defectFeedback   String?        @db.Text @default("") // 缺陷反馈（Markdown格式）
  featureId        String
  feature          Feature        @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  defects          Defect[]
}

// 缺陷优先级枚举
enum DefectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// 缺陷状态枚举
enum DefectStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// 缺陷表
model Defect {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text  // 富文本描述
  priority    DefectPriority @default(MEDIUM)
  status      DefectStatus   @default(OPEN)
  testCaseId  String
  testCase    TestCase       @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
